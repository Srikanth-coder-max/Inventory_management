# ── PostgreSQL (Supabase / Neon / local) ─────────────────────────────────────
# Use the pooling URL (port 6543 on Supabase/Neon for PgBouncer)
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"

# Use the direct connection URL for Prisma migrations (bypasses pooler)
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# ── Upstash Redis ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token-here"

# ── App ───────────────────────────────────────────────────────────────────────
# Set to your deployment URL in production (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── Cron job protection ───────────────────────────────────────────────────────
# Vercel passes this as Authorization: Bearer <secret>
CRON_SECRET="your-random-cron-secret-here"
